VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend API base (no trailing slash, include /api suffix).
# Dev: leave unset — Vite proxy forwards /api to localhost:8000.
# Prod: https://social-media-cms.yourdomain.com/api
VITE_API_BASE_URL=

# Branding shown on the public landing / privacy / terms pages
VITE_APP_NAME=
VITE_OPERATOR_NAME=
VITE_CONTACT_EMAIL=
# Optional social profile links (a platform is hidden when its URL is empty)
VITE_INSTAGRAM_URL=
VITE_YOUTUBE_URL=
VITE_TIKTOK_URL=
