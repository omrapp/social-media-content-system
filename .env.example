# ── Instagram Graph API (required) ──────────────────────────────────────────
IG_TOKEN=
IG_USER_ID=

# ── AI (required) ────────────────────────────────────────────────────────────
# Caption generation + refine + AI edit dispatch
OPENROUTER_API_KEY=
# Bulk category classifier (new downloads only, free tier ~30 req/min)
GROQ_API_KEY=

# ── Supabase (required) ──────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
# Backend-only service-role key. Bypasses RLS for server writes. NEVER ship to frontend.
SUPABASE_SERVICE_KEY=
# API auth (JWT verification)
SUPABASE_JWT_SECRET=
# Optional: Storage bucket name for the assets index (music/fonts/LUTs/intros/outros)
SUPABASE_STORAGE_BUCKET=

# ── Cloudflare R2 (required — public video hosting) ─────────────────────────
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Optional: storage cap in GB before cleanup (default 10)
R2_MAX_GB=

# ── Background music (required) ──────────────────────────────────────────────
PIXABAY_API_KEY=
# Optional: alternate/extra music source
JAMENDO_CLIENT_ID=

# ── Stock B-roll (optional) ───────────────────────────────────────────────────
PEXELS_API_KEY=

# ── Telegram bot (optional — enables push previews + inline approve/reject) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# poll (dev) | webhook (prod, via reverse proxy)
TELEGRAM_MODE=poll
# Required if TELEGRAM_MODE=webhook — random secret appended to the webhook path
TELEGRAM_WEBHOOK_SECRET=

# ── YouTube Shorts publishing (optional) ─────────────────────────────────────
# Google Cloud Console -> APIs -> YouTube Data API v3 -> OAuth 2.0 Client ID
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Run once: python -m backend.scripts.auth_youtube
YOUTUBE_REFRESH_TOKEN=

# ── TikTok publishing (optional) ─────────────────────────────────────────────
# developers.tiktok.com -> app -> Content Posting API scope
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Run once: python -m backend.scripts.auth_tiktok
TIKTOK_ACCESS_TOKEN=
# Refresh token for re-auth (valid 365 days)
TIKTOK_REFRESH_TOKEN=

# ── Zernio (optional alternative — managed IG+TikTok publishing API that
#    bypasses Meta/TikTok app review) ────────────────────────────────────────
# Get API key: https://zernio.com/dashboard/settings/api
# Account IDs: GET https://zernio.com/api/v1/accounts
ZERNIO_API_KEY=
ZERNIO_IG_ACCOUNT_ID=
ZERNIO_TT_ACCOUNT_ID=

# ── Google Drive / Photos import (optional) ──────────────────────────────────
# Enable Drive API + Photos Picker API in Google Cloud Console.
# Scopes: drive.readonly + photospicker.mediaitems.readonly
# Run once: python -m backend.scripts.auth_google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Reel editor (optional — falls back to SUPABASE_JWT_SECRET if unset) ─────
EDITOR_MEDIA_SECRET=

# ── Advanced / rarely-needed overrides ───────────────────────────────────────
# ML inference device for the optional caption-removal feature: cpu | cuda
DECAPTION_DEVICE=
# Override the local data directory (default ./downloads)
DATA_DIR=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated frontend origins allowed to call the API (localhost always allowed)
CORS_ORIGINS=
# Production Vercel URL + project slug (slug narrows the *.vercel.app preview regex)
VERCEL_FRONTEND_URL=
VERCEL_PROJECT_SLUG=

# ── Runtime ───────────────────────────────────────────────────────────────────
# dev | prod
ENV=dev
